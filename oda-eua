function renderChecklist() {
  var cont = document.getElementById('checklist-container');
  if (!cont) return;
  cont.innerHTML = '';
  CHECKLIST.forEach(function(txt, i) {
    var div = document.createElement('div');
    div.className = 'checklist-item' + (S.checkDone.indexOf(i) >= 0 ? ' checked' : '');
    div.innerHTML = '<input type="checkbox" id="cl-'+i+'" ' + (S.checkDone.indexOf(i) >= 0 ? 'checked' : '') + '><label for="cl-'+i+'">'+txt+'</label>';
    var cb = div.querySelector('input');
    (function(idx) {
      cb.addEventListener('change', function() {
        initAudio();
        if (cb.checked) { S.checkDone.push(idx); div.classList.add('checked'); sndClick(); ganharXP(5, 'Checklist '+(idx+1)); }
        else { S.checkDone.splice(S.checkDone.indexOf(idx), 1); div.classList.remove('checked'); }
        updateChecklist();
        salvarLocal();
      });
    })(i);
    cont.appendChild(div);
  });
  updateChecklist();
}

function updateChecklist() {
