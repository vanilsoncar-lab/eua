// ==================== AUDIO ====================
var audioCtx = null;
function initAudio() {
  if (!audioCtx) {
    try { audioCtx = new (window.AudioContext || window.webkitAudioContext)(); } catch(e) {}
  }
}
function tone(f, d, t, v, dl) {
  t = t || 'sine'; v = v || 0.1; dl = dl || 0;
  if (!audioCtx) return;
  try {
    var c = audioCtx, o = c.createOscillator(), g = c.createGain();
    o.connect(g); g.connect(c.destination); o.type = t;
    o.frequency.setValueAtTime(f, c.currentTime + dl);
    g.gain.setValueAtTime(0, c.currentTime + dl);
    g.gain.linearRampToValueAtTime(v, c.currentTime + dl + 0.02);
    g.gain.exponentialRampToValueAtTime(0.001, c.currentTime + dl + d);
    o.start(c.currentTime + dl); o.stop(c.currentTime + dl + d + 0.05);
  } catch(e) {}
}
function sndClick() { tone(700, 0.06, 'square', 0.05); tone(1000, 0.04, 'square', 0.03, 0.05); }
function sndOk() { [523, 659, 784].forEach(function(f,i){ tone(f, 0.28, 'triangle', 0.11, i*0.1); }); }
function sndUnlock() { [392, 523, 659, 784].forEach(function(f,i){ tone(f, 0.2, 'square', 0.06, i*0.08); }); }
function sndNav() { tone(440, 0.15, 'sine', 0.08); tone(660, 0.1, 'sine', 0.06, 0.15); }
function sndReveal() { tone(300, 0.3, 'sine', 0.1); tone(600, 0.2, 'sine', 0.08, 0.2); }
function sndErro() { tone(330, 0.35, 'sine', 0.1); tone(220, 0.3, 'sine', 0.08, 0.2); }
function sndFesta() { [523, 659, 784, 1047, 1319].forEach(function(f,i){ tone(f, 0.4, 'triangle', 0.12, i*0.1); tone(f*1.5, 0.3, 'triangle', 0.07, i*0.1+0.05); }); }

// ==================== XP E PROGRESSO ====================
var xpTimer;
function ganharXP(q, motivo) {
  initAudio(); 
  S.xp += q;
  atualizarHUD();
  var el = document.getElementById('xp-pop');
  if (el) { el.textContent = '+'+q+' XP' + (motivo ? ' — '+motivo : ''); el.classList.add('show'); }
  clearTimeout(xpTimer);
  xpTimer = setTimeout(function(){ if(el) el.classList.remove('show'); }, 2000);
  tone(880, 0.08, 'square', 0.06); tone(1200, 0.06, 'square', 0.04, 0.07);
  log('XP +'+q + (motivo ? ' ('+motivo+')' : ''));
  salvarLocal();
}

function atualizarHUD() {
  var n = getNivel(S.xp);
  var pct = n.n < 5 ? Math.round((S.xp - n.min) / (n.max - n.min) * 100) : 100;
  var hudAv = document.getElementById('hud-av'); if (hudAv) hudAv.textContent = n.av;
  var hudNome = document.getElementById('hud-nome'); if (hudNome) hudNome.textContent = S.nome || '—';
  var hudNivel = document.getElementById('hud-nivel'); if (hudNivel) hudNivel.textContent = 'Nível '+n.n+' — '+n.nome;
  var hudFill = document.getElementById('hud-fill'); if (hudFill) hudFill.style.width = pct+'%';
  var hudXp = document.getElementById('hud-xp'); if (hudXp) hudXp.textContent = S.xp+' XP';
  var navXpLbl = document.getElementById('nav-xp-lbl'); if (navXpLbl) navXpLbl.textContent = 'XP: '+S.xp;
  var navXpFill = document.getElementById('nav-xp-fill'); if (navXpFill) navXpFill.style.width = pct+'%';
  var max = Math.max.apply(null, S.unlocked.filter(function(x){ return typeof x === 'number' && x >= 1; }));
  var barraFill = document.getElementById('barra-top-fill'); if (barraFill) barraFill.style.width = Math.round(max/6*100)+'%';
}

// ==================== LOGIN E CADASTRO ====================
function irPagina(id) {
  document.getElementById('pg-login').style.display = 'none';
  document.getElementById('pg-cadastro').style.display = 'none';
  document.getElementById(id).style.display = 'block';
  document.getElementById('msg-login').textContent = '';
  document.getElementById('msg-cadastro').textContent = '';
}

function msgAuth(id, texto, tipo) {
  var el = document.getElementById(id);
  if (el) { el.textContent = texto; el.className = 'login-msg ' + tipo; }
}

function fazerLogin() {
  var email = document.getElementById('l-email').value.trim().toLowerCase();
  var senha = document.getElementById('l-senha').value;

  if (!email || email.indexOf('@') < 0) { msgAuth('msg-login', 'E-mail inválido.', 'err'); return; }
  if (!senha) { msgAuth('msg-login', 'Informe a senha.', 'err'); return; }

  var chave = CHAVE_AUTH + email;
  var raw = null;
  try { raw = localStorage.getItem(chave); } catch(e) {}

  if (!raw) { msgAuth('msg-login', 'E-mail não encontrado. Crie uma conta primeiro.', 'err'); return; }

  var obj = null;
  try { obj = JSON.parse(raw); } catch(e) { msgAuth('msg-login', 'Erro nos dados.', 'err'); return; }

  if (obj.senha !== senha) { msgAuth('msg-login', 'Senha incorreta.', 'err'); return; }

  carregarObj(obj);
  S.email = email;
  msgAuth('msg-login', 'Bem-vindo(a) de volta, ' + S.nome + '!', 'ok');
  log('Login: ' + S.nome + ' (' + email + ')');
  setTimeout(iniciarApp, 400);
}

function fazerCadastro() {
  var nome = document.getElementById('c-nome').value.trim();
  var email = document.getElementById('c-email').value.trim().toLowerCase();
  var turma = document.getElementById('c-turma').value.trim();
  var ano = document.getElementById('c-ano').value.trim();
  var senha = document.getElementById('c-senha').value;
  var senha2 = document.getElementById('c-senha2').value;

  if (!nome) { msgAuth('msg-cadastro', 'Informe o nome completo.', 'err'); return; }
  if (!email || email.indexOf('@') < 0) { msgAuth('msg-cadastro', 'E-mail inválido.', 'err'); return; }
  if (!turma) { msgAuth('msg-cadastro', 'Informe a turma.', 'err'); return; }
  if (!ano) { msgAuth('msg-cadastro', 'Informe o ano letivo.', 'err'); return; }
  if (!senha) { msgAuth('msg-cadastro', 'Crie uma senha.', 'err'); return; }
  if (senha.length < 4) { msgAuth('msg-cadastro', 'Senha muito curta (mínimo 4 caracteres).', 'err'); return; }
  if (senha !== senha2) { msgAuth('msg-cadastro', 'As senhas não coincidem.', 'err'); return; }

  var chave = CHAVE_AUTH + email;
  try {
    if (localStorage.getItem(chave)) { msgAuth('msg-cadastro', 'E-mail já cadastrado. Faça login.', 'err'); return; }
  } catch(e) {}

  S.nome = nome; S.email = email; S.turma = turma; S.ano = ano; S.senha = senha;
  S.xp = 0; S.unlocked = [1]; S.tela = 1;

  var dados = {
    nome: nome, email: email, turma: turma, ano: ano, senha: senha, xp: 0,
    philoAbertos: [], tlRevelados: [], notaOk: false, checkDone: [],
    unlocked: [1], tela: 1, hist: [], enigResp: [], avancos: [], colVisit: [], enigPts: 0
  };

  try {
    localStorage.setItem(chave, JSON.stringify(dados));
  } catch(e) { msgAuth('msg-cadastro', 'Erro ao salvar.', 'err'); return; }

  msgAuth('msg-cadastro', 'Conta criada com sucesso!', 'ok');
  log('Cadastro: ' + nome + ' (' + email + ')');
  setTimeout(iniciarApp, 400);
}

