function respEnigma(num, el, correta) {
  if (S.enigResp.indexOf(num) >= 0) return;
  initAudio();
  S.enigResp.push(num);
  var opts = el.parentElement.querySelectorAll('.enigma-opt');
  for (var i = 0; i < opts.length; i++) opts[i].classList.add('disabled');
  var fb = document.getElementById('eng'+num+'-fb');
  if (correta) {
    el.classList.add('correct');
    S.enigPts += 10;
    if (fb) { fb.className = 'enigma-feedback ok'; fb.innerHTML = EFB[num].ok; }
    ganharXP(50, 'Enigma '+num);
    sndOk();
  } else {
    el.classList.add('wrong');
    if (fb) { fb.className = 'enigma-feedback não'; fb.innerHTML = EFB[num].nao; }
    var ops = el.parentElement.querySelectorAll('.enigma-opt');
    for (var j = 0; j < ops.length; j++) {
      if (ops[j].getAttribute('data-correct') === 'true') ops[j].classList.add('correct');
    }
    sndErro();
  }
  salvarLocal();
}

// ==================== ATIVIDADE FINAL (DM) ====================
var dmPts = 0;

function verificarLacunas() {
  initAudio();
  var lacunas = document.querySelectorAll('.dm-lacuna');
  dmPts = 0;
  lacunas.forEach(function(lac) {
    var resp = lac.getAttribute('data-resp').toLowerCase().trim();
    var val = lac.textContent.toLowerCase().trim();
    if (val === resp) {
      lac.classList.add('correta');
      dmPts++;
      sndClick();
    } else {
      lac.classList.add('errada');
      lac.textContent = lac.getAttribute('data-resp');
      sndErro();
    }
    lac.contentEditable = false;
  });
  if (dmPts > 0) ganharXP(Math.round(40 * dmPts / lacunas.length), 'Lacunas DM');
  salvarLocal();
}

function finalizarAtividadeDM() {
  var r = document.getElementById('resultado-dm');
  if (!r) return;
  r.style.display = 'block';
  var maxPts = document.querySelectorAll('.dm-lacuna').length;
  document.getElementById('dm-placar').textContent = dmPts + ' / ' + maxPts + ' pts';
  var e = dmPts >= (maxPts-1) ? '★★★' : dmPts >= (maxPts-2) ? '★★☆' : '★☆☆';
  document.getElementById('dm-estrelas').textContent = e;
  document.getElementById('dm-msg').textContent = dmPts >= (maxPts-1) ? 'Excelente!' : (dmPts >= (maxPts-2) ? 'Bom trabalho!' : 'Continue tentando!');
  ganharXP(100, 'Missão 6 concluída');
  salvarLocal();
  confetti();
}

