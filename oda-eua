<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>Construindo os EUA — EMF Soares de Barros</title>
<link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=Montserrat:wght@400;600;700;900&family=Open+Sans:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">
<style>
*{box-sizing:border-box;margin:0;padding:0;}
:root{
  --gold:#c9a84c; --gold2:#e8cc7a; --green:#5d9c3a; --green2:#3d7a1f;
  --dark:#0d0f0d; --xp:#80ff00; --blue:#2980b9; --red:#c0392b;
  --navy:#1a2a4a; --crimson:#8b1a1a; --success:#2ecc71;
  --sidebar:#1e3a5a; --accent:#2980b9;
}
body{font-family:"Open Sans",sans-serif;background:#0d0f0d;color:#f0f4ff;min-height:100vh;}

/* LOGIN */
#login-page{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:1.5rem;
  background:repeating-linear-gradient(0deg,transparent,transparent 31px,rgba(93,156,58,.05) 32px),
  repeating-linear-gradient(90deg,transparent,transparent 31px,rgba(93,156,58,.05) 32px),
  linear-gradient(160deg,#0a1f0a,#0d0f0d);}
#login-page.oculto{display:none;}
.login-box{background:rgba(0,0,0,.9);border:3px solid #c9a84c;max-width:390px;width:100%;
  padding:1.8rem 1.5rem 1.5rem;box-shadow:6px 6px 0 rgba(0,0,0,.5);position:relative;}
.login-box::before{content:'';position:absolute;top:-2px;left:-2px;right:-2px;height:4px;
  background:linear-gradient(90deg,#c9a84c,#fff8c0,#c9a84c);}
.login-logo{display:block;width:85px;height:106px;object-fit:contain;background:white;
  border-radius:4px;padding:4px;margin:0 auto 1rem;box-shadow:3px 3px 0 rgba(0,0,0,.5);}
.login-titulo{font-family:"Press Start 2P",monospace;font-size:.58rem;color:#c9a84c;
  text-align:center;line-height:2;margin-bottom:.3rem;text-shadow:2px 2px 0 #000;}
.login-sub{font-family:"Montserrat",sans-serif;font-size:.72rem;color:rgba(255,255,255,.5);
  text-align:center;margin-bottom:1.2rem;font-style:italic;}
.campo{margin-bottom:.75rem;}
.campo label{display:block;font-family:"Press Start 2P",monospace;font-size:.44rem;
  color:#80ff00;margin-bottom:.32rem;letter-spacing:1px;}
.campo input{width:100%;padding:.6rem .8rem;background:rgba(0,0,0,.7);border:2px solid #444;
  color:white;font-size:.95rem;border-radius:2px;outline:none;font-family:"Open Sans",sans-serif;}
.campo input:focus{border-color:#c9a84c;}
.campo input::placeholder{color:rgba(255,255,255,.3);}
.btn-verde{display:block;width:100%;padding:.72rem;background:#5d9c3a;
  border:none;border-bottom:4px solid #3d7a1f;color:white;
  font-family:"Press Start 2P",monospace;font-size:.56rem;letter-spacing:1px;
  cursor:pointer;border-radius:2px;margin-top:.4rem;text-shadow:1px 1px 0 rgba(0,0,0,.5);}
.btn-verde:hover{background:#6dac4a;}
.btn-verde:active{border-bottom-width:1px;transform:translateY(3px);}
.btn-dourado{background:rgba(201,168,76,.15);border-bottom-color:#a07010;color:#c9a84c;margin-top:.35rem;}
.btn-dourado:hover{background:rgba(201,168,76,.28);}
.btn-outline{background:transparent !important;border:2px solid rgba(201,168,76,.5) !important;
  border-bottom-width:2px !important;color:#c9a84c !important;}
.btn-outline:hover{background:rgba(201,168,76,.12) !important;}
.auth-sep{display:flex;align-items:center;gap:.6rem;margin:.6rem 0 .45rem;}
.auth-sep::before,.auth-sep::after{content:'';flex:1;height:1px;background:rgba(255,255,255,.18);}
.auth-sep span{font-size:.62rem;color:rgba(255,255,255,.38);white-space:nowrap;}
.login-msg{font-size:.7rem;text-align:center;margin-top:.5rem;min-height:1.2em;line-height:1.5;}
.login-msg.ok{color:#80ff00;} .login-msg.err{color:#ff6b6b;}

/* APP */
#app-page{display:none;}
#app-page.visivel{display:block;}

/* HUD */
#hud{position:sticky;top:0;background:rgba(0,0,0,.95);border-bottom:3px solid #c9a84c;
  padding:.42rem .75rem;display:flex;align-items:center;gap:.65rem;z-index:200;}
.hud-av{font-size:1.5rem;width:38px;height:38px;display:flex;align-items:center;justify-content:center;
  border:2px solid #c9a84c;border-radius:2px;background:#111;flex-shrink:0;}
.hud-info{flex:1;min-width:0;}
.hud-nome{font-family:"Press Start 2P",monospace;font-size:.46rem;color:white;
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-bottom:2px;}
.hud-nivel{font-family:"Press Start 2P",monospace;font-size:.38rem;color:#c9a84c;margin-bottom:3px;}
.hud-barra-w{display:flex;align-items:center;gap:4px;}
.hud-barra{flex:1;height:6px;background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.18);overflow:hidden;}
.hud-barra-fill{height:100%;background:#80ff00;width:0%;transition:width .6s;box-shadow:0 0 5px #80ff00;}
.hud-xp{font-family:"Press Start 2P",monospace;font-size:.36rem;color:#80ff00;white-space:nowrap;}
.btn-hud{background:rgba(201,168,76,.12);border:1px solid rgba(201,168,76,.35);color:#c9a84c;
  padding:.26rem .48rem;cursor:pointer;font-family:"Press Start 2P",monospace;font-size:.34rem;flex-shrink:0;}
.btn-hud:hover{background:rgba(201,168,76,.28);}

/* LAYOUT */
#layout{display:flex;min-height:calc(100vh - 56px);overflow:hidden;}

/* SIDEBAR */
#sidebar{width:240px;min-width:240px;background:rgba(0,0,0,.9);border-right:3px solid #222;
  display:flex;flex-direction:column;padding:.75rem .6rem;flex-shrink:0;overflow-y:auto;max-height:calc(100vh - 56px);}
.side-titulo{font-family:"Press Start 2P",monospace;font-size:.42rem;color:#c9a84c;
  text-align:center;padding:.4rem;background:rgba(255,255,255,.04);
  border:1px solid rgba(201,168,76,.2);margin-bottom:.35rem;letter-spacing:1px;}
.missão-item{display:flex;align-items:center;gap:.45rem;padding:.45rem .5rem;
  margin-bottom:2px;cursor:default;opacity:.38;border:1px solid transparent;transition:.2s;}
.missão-item.ativa{opacity:1;cursor:pointer;}
.missão-item.ativa:hover{background:rgba(255,255,255,.06);}
.missão-item.atual{background:rgba(93,156,58,.15);border-color:#5d9c3a;opacity:1;}
.missão-num{font-family:"Press Start 2P",monospace;font-size:.38rem;color:#c9a84c;
  background:rgba(0,0,0,.5);border:1px solid rgba(201,168,76,.3);
  width:20px;height:20px;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
.missão-item.atual .missão-num{background:#5d9c3a;color:white;border-color:#3d7a1f;}
.missão-label{font-size:.7rem;color:#d1e3f8;flex:1;min-width:0;line-height:1.3;}
.missão-item.atual .missão-label{color:#b8ffa0;font-weight:600;}
.missão-lock{font-size:.6rem;flex-shrink:0;color:rgba(255,255,255,.28);}
.missão-item.ativa .missão-lock{color:#80ff00;}
#nav-xp-wrap{padding:.4rem .25rem;margin-top:.28rem;}
#nav-xp-lbl{font-family:"Press Start 2P",monospace;font-size:.34rem;color:#80ff00;text-align:center;margin-bottom:3px;}
#nav-xp-bar{height:7px;background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.15);overflow:hidden;}
#nav-xp-fill{height:100%;background:#80ff00;width:0%;transition:width .5s;box-shadow:0 0 5px #80ff00;}
.nav-bottom{margin-top:auto;padding-top:.45rem;border-top:1px solid rgba(255,255,255,.07);display:flex;flex-direction:column;gap:.25rem;}
.btn-nav{padding:.35rem .5rem;cursor:pointer;font-size:.62rem;width:100%;border:1px solid;background:transparent;transition:.2s;text-align:center;border-radius:2px;}
.btn-sair{border-color:rgba(139,26,26,.45);color:#ff9090;}
.btn-sair:hover{background:rgba(139,26,26,.3);}
.btn-reiniciar{border-color:rgba(201,168,76,.35);color:#c9a84c;font-family:"Press Start 2P",monospace;font-size:.36rem;}
.btn-reiniciar:hover{background:rgba(201,168,76,.15);}
.btn-hist{border-color:transparent;color:rgba(201,168,76,.45);font-size:.58rem;text-decoration:underline;}
.nav-rodape{font-size:.44rem;color:rgba(255,255,255,.16);text-align:center;margin-top:.32rem;line-height:1.6;}

/* CONTEÚDO */
#conteudo{flex:1;overflow-y:auto;height:calc(100vh - 56px);
  background:repeating-linear-gradient(0deg,transparent,transparent 31px,rgba(255,255,255,.012) 32px),
  repeating-linear-gradient(90deg,transparent,transparent 31px,rgba(255,255,255,.012) 32px),#16213e;
  min-width:0;}
#barra-top{height:3px;background:rgba(255,255,255,.06);}
#barra-top-fill{height:100%;background:linear-gradient(90deg,#5d9c3a,#c9a84c);width:0%;transition:width .5s;}
.screen{display:none;}
.screen.active{display:block;animation:fadeIn .35s ease;}
@keyframes fadeIn{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}
.screen-inner{max-width:900px;margin:0 auto;padding:1.4rem 1.1rem 5rem;}

/* RESPONSIVO NOTEBOOK/CHROMEBOOK */
@media (min-width: 768px) and (max-width: 1199px) {
  #sidebar { width: 210px; min-width: 210px; }
  .screen-inner { max-width: 100%; padding: 1rem 1.2rem 5rem; }
  .content-card p, .content-card ul, .roteiro-item p { font-size: .85rem; }
  .section-title { font-size: 1.1rem; }
}

@media (max-width: 767px) {
  #sidebar { display: none; position: fixed; top: 56px; left: 0; bottom: 0; width: 240px;
    transform: translateX(-100%); transition: transform .3s; z-index: 199; padding-top: .55rem; }
  #sidebar.aberto { display: flex; transform: translateX(0); }
  #overlay-nav { display: none; position: fixed; inset: 0; background: rgba(0,0,0,.55); z-index: 198; }
  #overlay-nav.aberto { display: block; }
  #btn-menu { display: flex; position: fixed; top: 66px; left: 7px; z-index: 300;
    background: rgba(0,0,0,.93); border: 2px solid #c9a84c; padding: 6px 7px; cursor: pointer;
    flex-direction: column; gap: 4px; }
  #btn-menu span { display: block; width: 16px; height: 2px; background: #c9a84c; }
  .screen-inner { padding: 1rem .8rem 5rem; }
}

/* XP POPUP */
#xp-pop{position:fixed;top:66px;right:14px;background:rgba(0,0,0,.95);border:2px solid #80ff00;
  padding:.42rem .8rem;font-family:"Press Start 2P",monospace;font-size:.5rem;color:#80ff00;
  box-shadow:0 0 16px rgba(128,255,0,.3);z-index:5000;opacity:0;transform:translateY(-8px);
  transition:all .3s;pointer-events:none;}
#xp-pop.show{opacity:1;transform:translateY(0);}

/* AVANÇO POPUP */
#av-pop{position:fixed;bottom:68px;left:50%;transform:translateX(-50%) translateY(15px);
  background:rgba(0,0,0,.97);border:3px solid #c9a84c;padding:.85rem 1.2rem;
  text-align:center;min-width:230px;z-index:5000;opacity:0;transition:all .4s;
  pointer-events:none;box-shadow:0 0 26px rgba(201,168,76,.35);}
#av-pop.show{opacity:1;transform:translateX(-50%) translateY(0);}
.av-label{font-family:"Press Start 2P",monospace;font-size:.42rem;color:#c9a84c;letter-spacing:2px;margin-bottom:.32rem;}
.av-icon{font-size:1.8rem;display:block;margin:.22rem 0;}
.av-nome{font-family:"Press Start 2P",monospace;font-size:.48rem;color:white;line-height:1.6;}
.av-xp{font-family:"Press Start 2P",monospace;font-size:.42rem;color:#80ff00;margin-top:.26rem;}

/* TOAST */
#toast{position:fixed;bottom:14px;right:14px;background:rgba(0,0,0,.93);color:#80ff00;
  padding:.42rem .8rem;border:1px solid #80ff00;font-family:"Press Start 2P",monospace;font-size:.38rem;
  z-index:8000;opacity:0;transform:translateY(50px);transition:all .3s;box-shadow:0 0 8px rgba(128,255,0,.2);}
#toast.show{opacity:1;transform:translateY(0);}

/* MODAIS */
.modal-fundo{display:none;position:fixed;inset:0;background:rgba(0,0,0,.84);
  z-index:3000;align-items:center;justify-content:center;padding:1rem;backdrop-filter:blur(4px);}
.modal-fundo.aberto{display:flex;}
.modal-caixa{background:#080808;border:3px solid #c9a84c;width:100%;max-width:330px;
  padding:1.3rem;text-align:center;box-shadow:0 0 36px rgba(201,168,76,.25);}
.modal-icon{font-size:2.2rem;display:block;margin-bottom:.45rem;}
.modal-titulo{font-family:"Press Start 2P",monospace;font-size:.55rem;color:#c9a84c;margin-bottom:.5rem;line-height:1.6;}
.modal-msg{font-size:.78rem;color:rgba(255,255,255,.55);line-height:1.6;margin-bottom:1rem;}
.modal-btns{display:flex;gap:.55rem;}
.btn-sim{flex:1;padding:.55rem;background:rgba(192,57,43,.45);border:2px solid #c0392b;
  color:#ff9090;cursor:pointer;font-family:"Press Start 2P",monospace;font-size:.4rem;}
.btn-não{flex:1;padding:.55rem;background:rgba(41,128,185,.22);border:2px solid #2980b9;
  color:#91c7ff;cursor:pointer;font-family:"Press Start 2P",monospace;font-size:.4rem;}

/* PAINEL PROFESSOR */
#painel{display:none;position:fixed;inset:0;background:rgba(0,0,0,.94);
  z-index:4000;overflow-y:auto;padding:1.3rem 1rem;backdrop-filter:blur(5px);}
#painel.aberto{display:block;}
.painel-hdr{max-width:840px;margin:0 auto 1.2rem;display:flex;align-items:center;
  justify-content:space-between;flex-wrap:wrap;gap:.6rem;}
.painel-titulo{font-family:"Press Start 2P",monospace;font-size:.62rem;color:#c9a84c;}
.painel-fechar{background:rgba(139,26,26,.4);border:1px solid rgba(139,26,26,.6);
  color:#ff9090;padding:.35rem .8rem;cursor:pointer;font-family:"Press Start 2P",monospace;font-size:.4rem;}
.painel-login-box{max-width:340px;margin:2rem auto;background:rgba(0,0,0,.8);
  border:2px solid #c9a84c;padding:1.3rem;text-align:center;}
.painel-login-box h3{font-family:"Press Start 2P",monospace;font-size:.52rem;color:#c9a84c;margin-bottom:.8rem;}
.painel-grid{max-width:840px;margin:0 auto;display:grid;
  grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:.85rem;}
.painel-card{background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.1);border-radius:3px;padding:.85rem;}
.painel-card h4{font-family:"Press Start 2P",monospace;font-size:.46rem;color:#c9a84c;margin-bottom:.65rem;}
.aluno-linha{display:flex;align-items:center;gap:.5rem;padding:.42rem .5rem;
  margin-bottom:3px;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.07);}
.pos{font-family:"Press Start 2P",monospace;font-size:.44rem;color:#c9a84c;width:28px;flex-shrink:0;}
.av2{font-size:1rem;flex-shrink:0;}
.info2{flex:1;min-width:0;}
.nome2{font-size:.73rem;color:white;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.sub2{font-size:.6rem;color:rgba(255,255,255,.42);}
.xp2{font-family:"Press Start 2P",monospace;font-size:.38rem;color:#80ff00;flex-shrink:0;}

/* CARDS */
.content-card{background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.09);border-radius:14px;padding:1.2rem;margin-bottom:1rem;box-shadow:0 4px 18px rgba(0,0,0,.2);}
.content-card h3{font-family:'Montserrat',sans-serif;font-size:.86rem;color:#91c7ff;margin-bottom:8px;display:flex;align-items:center;gap:7px;}
.content-card p{font-size:.9rem;line-height:1.8;color:#d1e3f8;}
.content-card ul{padding-left:1.2rem;line-height:1.85;font-size:.9rem;color:#d1e3f8;}

/* FILÓSOFOS */
#philosophers-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(205px,1fr));gap:9px;margin:1rem 0;}
.philosopher-card{background:rgba(255,255,255,.05);border:1.5px solid rgba(255,255,255,.1);border-radius:12px;padding:.95rem;cursor:pointer;transition:all .3s;min-height:90px;display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden;}
.philosopher-card:hover{border-color:var(--gold);background:rgba(201,168,76,.08);transform:translateY(-2px);}
.philosopher-card.opened{border-color:var(--gold);background:rgba(201,168,76,.06);cursor:default;transform:none;}
.philosopher-card.opened::after{content:'✓';position:absolute;top:6px;right:8px;color:var(--gold);font-size:.85rem;}
.philo-front{text-align:center;}
.philo-emoji{font-size:1.75rem;margin-bottom:4px;display:block;}
.philo-front h4{font-family:'Montserrat',sans-serif;font-size:.78rem;color:#91c7ff;margin-bottom:2px;}
.philo-origin{font-size:.68rem;color:rgba(255,255,255,.45);font-style:italic;}
.philo-tap{font-size:.64rem;color:var(--gold);font-family:'Montserrat',sans-serif;margin-top:4px;}
.philo-back{display:none;}
.philosopher-card.opened .philo-front{display:none;}
.philosopher-card.opened .philo-back{display:block;}
.philo-back h4{font-family:'Montserrat',sans-serif;font-size:.78rem;color:#91c7ff;margin-bottom:2px;}
.philo-back .philo-orig{font-size:.66rem;color:var(--gold);font-style:italic;margin-bottom:5px;}
.philo-back p{font-size:.8rem;line-height:1.55;color:#d1e3f8;}
.philo-hint{text-align:center;font-size:.75rem;color:rgba(255,255,255,.4);font-style:italic;margin-bottom:4px;}
#philo-counter{text-align:center;font-family:'Montserrat',sans-serif;font-size:.74rem;color:var(--crimson);margin-top:4px;min-height:1.1em;}

/* MAPA */
#map-colonies{width:100%;border-radius:14px;overflow-x:auto;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.1);margin:1.1rem 0;}
#map-colonies svg{width:100%;height:auto;display:block;}
.colony-path{cursor:pointer;transition:all .25s;}
.colony-path:hover{filter:brightness(1.35) drop-shadow(0 0 6px rgba(201,168,76,.7));}
.colony-path.active{filter:brightness(1.45) drop-shadow(0 0 9px rgba(201,168,76,.9));}
#colony-info{padding:.95rem 1.1rem;border-top:1px solid rgba(255,255,255,.08);min-height:85px;}
#colony-info h4{font-family:'Montserrat',sans-serif;font-size:.88rem;color:var(--gold);margin-bottom:3px;}
#colony-info p{font-size:.82rem;color:#d1e3f8;line-height:1.65;}
.map-hint{text-align:center;font-size:.72rem;color:rgba(255,255,255,.38);font-style:italic;margin-bottom:3px;}

/* TIMELINE */
#timeline-container{position:relative;padding:1rem 0;margin:1rem 0;}
.tl-line{position:absolute;left:27px;top:0;bottom:0;width:3px;background:linear-gradient(to bottom,var(--gold),var(--crimson));border-radius:3px;}
.timeline-item{display:flex;gap:10px;margin-bottom:9px;cursor:pointer;position:relative;}
.tl-dot{width:54px;min-width:54px;height:54px;border-radius:50%;background:rgba(255,255,255,.06);border:2.5px solid rgba(255,255,255,.12);display:flex;align-items:center;justify-content:center;flex-direction:column;font-family:'Montserrat',sans-serif;font-size:.57rem;color:rgba(255,255,255,.45);line-height:1.1;text-align:center;transition:all .3s;z-index:1;}
.timeline-item:hover .tl-dot,.timeline-item.revealed .tl-dot{background:var(--navy);border-color:var(--gold);color:var(--gold-light);}
.timeline-item.revealed .tl-dot{box-shadow:0 0 0 4px rgba(201,168,76,.18);}
.tl-content{flex:1;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.08);border-radius:10px;padding:8px 12px;transition:all .3s;}
.timeline-item:hover .tl-content{border-color:rgba(201,168,76,.4);}
.timeline-item.revealed .tl-content{background:rgba(201,168,76,.06);border-color:rgba(201,168,76,.35);}
.tl-title{font-family:'Montserrat',sans-serif;font-size:.82rem;color:#91c7ff;margin-bottom:2px;display:flex;align-items:center;justify-content:space-between;}
.tl-check{color:var(--gold);font-size:.88rem;display:none;}
.timeline-item.revealed .tl-check{display:inline;}
.tl-desc{font-size:.82rem;line-height:1.6;color:#d1e3f8;display:none;margin-top:4px;}
.timeline-item.revealed .tl-desc{display:block;}
.tl-hint{font-size:.68rem;color:rgba(255,255,255,.35);font-style:italic;}
.timeline-item.revealed .tl-hint{display:none;}
#tl-counter{text-align:center;font-family:'Montserrat',sans-serif;font-size:.74rem;color:var(--crimson);margin-top:4px;}

/* ENIGMA */
.enigma-box{background:linear-gradient(135deg,rgba(26,42,74,.9),rgba(13,24,41,.95));border:2px solid rgba(201,168,76,.5);border-radius:14px;padding:1.3rem;margin:1.3rem 0;position:relative;overflow:hidden;cursor:pointer;transition:all .3s;}
.enigma-box::before{content:'';position:absolute;inset:0;background:radial-gradient(circle at 30% 50%,rgba(201,168,76,.08),transparent 60%);}
.enigma-box:hover{border-color:var(--gold);box-shadow:0 6px 24px rgba(201,168,76,.2);}
.enigma-box.revealed{cursor:default;}
.enigma-header{display:flex;align-items:center;gap:10px;margin-bottom:.7rem;position:relative;}
.enigma-icon{font-size:1.6rem;animation:enigmaPulse 2s ease-in-out infinite;}
@keyframes enigmaPulse{0%,100%{transform:scale(1);filter:drop-shadow(0 0 4px rgba(201,168,76,.4));}50%{transform:scale(1.1);filter:drop-shadow(0 0 10px rgba(201,168,76,.8));}}
.enigma-title{font-family:'Montserrat',sans-serif;font-size:.8rem;color:var(--gold);letter-spacing:.8px;}
.enigma-question{font-size:.88rem;line-height:1.7;color:#d1e3f8;position:relative;margin-bottom:.8rem;font-style:italic;}
.enigma-options{display:grid;gap:6px;}
.enigma-opt{background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.12);border-radius:8px;padding:.65rem 1rem;cursor:pointer;font-size:.82rem;color:#d1e3f8;transition:all .2s;display:flex;gap:8px;align-items:center;}
.enigma-opt:hover{border-color:var(--gold);background:rgba(201,168,76,.08);}
.enigma-opt.correct{background:rgba(46,204,113,.15);border-color:rgba(46,204,113,.5);color:#6effa0;pointer-events:none;}
.enigma-opt.wrong{background:rgba(220,53,69,.12);border-color:rgba(220,53,69,.4);color:#ff9090;pointer-events:none;}
.enigma-opt.disabled{pointer-events:none;opacity:.5;}
.enigma-feedback{margin-top:.8rem;padding:.7rem .9rem;border-radius:8px;font-size:.82rem;line-height:1.55;display:none;}
.enigma-feedback.ok{display:block;background:rgba(46,204,113,.12);border:1px solid rgba(46,204,113,.3);color:#6effa0;}
.enigma-feedback.não{display:block;background:rgba(220,53,69,.1);border:1px solid rgba(220,53,69,.3);color:#ff9090;}
.enigma-pts{font-family:'Montserrat',sans-serif;font-size:.62rem;color:var(--gold);margin-left:auto;background:rgba(201,168,76,.15);border-radius:10px;padding:2px 7px;flex-shrink:0;}

/* BTN CONTINUAR */
.nav-btn-wrapper{text-align:center;margin-top:1.7rem;}
.btn-continue{display:inline-flex;align-items:center;gap:7px;padding:12px 1.9rem;background:linear-gradient(135deg,var(--navy),#253a6a);color:var(--gold-light);border:1.5px solid var(--gold);border-radius:40px;font-family:'Montserrat',sans-serif;font-size:.86rem;letter-spacing:.5px;cursor:pointer;transition:all .3s;box-shadow:0 4px 16px rgba(26,42,74,.35);}
.btn-continue:hover:not(:disabled){transform:translateY(-2px);box-shadow:0 8px 24px rgba(26,42,74,.45);}
.btn-continue:disabled{opacity:.35;cursor:not-allowed;transform:none;}
.btn-continue.locked{background:linear-gradient(135deg,#333,#222);border-color:#555;color:#888;}
.lock-hint{font-size:.7rem;color:rgba(255,255,255,.35);font-style:italic;margin-top:5px;display:block;}

/* CHECKLIST */
#checklist-progress-label{text-align:center;font-family:'Montserrat',sans-serif;font-size:.71rem;color:rgba(255,255,255,.4);margin-bottom:4px;}
#checklist-progress-bar{height:7px;background:rgba(255,255,255,.1);border-radius:10px;overflow:hidden;margin-bottom:11px;}
#checklist-progress-fill{height:100%;background:linear-gradient(90deg,var(--crimson),var(--gold));border-radius:10px;width:0%;transition:width .5s;}
.checklist-item{display:flex;align-items:flex-start;gap:9px;padding:8px 11px;border-radius:9px;margin-bottom:5px;cursor:pointer;transition:background .2s;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.07);}
.checklist-item:hover{background:rgba(255,255,255,.08);}
.checklist-item.checked{background:rgba(46,204,113,.1);border-color:rgba(46,204,113,.3);}
.checklist-item input[type="checkbox"]{width:15px;height:15px;accent-color:var(--navy);cursor:pointer;flex-shrink:0;margin-top:1px;}
.checklist-item label{font-size:.84rem;line-height:1.5;color:#d1e3f8;cursor:pointer;}
.checklist-item.checked label{color:#6effa0;text-decoration:line-through;text-decoration-color:rgba(110,255,160,.4);}

/* PRÉ-LEITURA */
.prereading-box {
  background: linear-gradient(160deg, #0b1e30 0%, #0f2540 100%);
  border: 2px solid var(--gold);
  border-radius: 12px;
  margin: 0 0 1.4rem;
  position: relative;
  overflow: hidden;
  box-shadow: 0 6px 28px rgba(201,168,76,.22);
}
.prereading-header {
  background: linear-gradient(90deg, #b8891e 0%, #c9a84c 50%, #b8891e 100%);
  display: flex;
  align-items: center;
  gap: 9px;
  padding: .6rem 1.1rem;
}
.prereading-icon { font-size: 1.1rem; flex-shrink: 0; }
.prereading-title { font-family: 'Montserrat', sans-serif; font-size: .78rem; color: #1a1a00; letter-spacing: 1px; font-weight: 900; text-transform: uppercase; }
.prereading-fase { margin-left: auto; font-family: 'Montserrat', sans-serif; font-size: .58rem; color: rgba(26,26,0,.65); letter-spacing: .5px; white-space: nowrap; font-weight: 700; }
.prereading-body { font-size: .88rem; line-height: 1.75; color: #d1e3f8; padding: .85rem 1.1rem .5rem; }
.prereading-caderno { margin: 0 1.1rem .85rem; background: rgba(201,168,76,.11); border: 1px solid rgba(201,168,76,.35); border-radius: 8px; padding: .7rem .95rem; display: flex; gap: 9px; align-items: flex-start; }
.prereading-caderno .cad-icon { font-size: 1rem; flex-shrink: 0; margin-top: 2px; }
.prereading-caderno p { font-size: .83rem; color: var(--gold-light); line-height: 1.65; margin: 0; font-family: 'Montserrat', sans-serif; }

/* ROTEIRO */
.roteiro-section{margin-bottom:1.4rem;}
.roteiro-section-title{font-family:'Montserrat',sans-serif;font-size:.9rem;color:var(--gold-light);display:flex;align-items:center;gap:8px;margin-bottom:.8rem;padding-bottom:.45rem;border-bottom:1px solid rgba(201,168,76,.2);}
.roteiro-section-title .num{background:var(--accent);color:white;border-radius:50%;width:22px;height:22px;display:inline-flex;align-items:center;justify-content:center;font-size:.72rem;font-weight:700;flex-shrink:0;}
.roteiro-item{display:flex;gap:9px;align-items:flex-start;margin-bottom:.6rem;}
.roteiro-item::before{content:'▸';color:var(--gold);flex-shrink:0;margin-top:2px;font-size:.88rem;}
.roteiro-item p{font-size:.86rem;line-height:1.7;color:#d1e3f8;margin:0;}
.reflita-box{background:rgba(201,168,76,.07);border:1px solid rgba(201,168,76,.22);border-radius:10px;padding:.85rem 1rem;margin:.8rem 0 1.1rem;display:flex;gap:9px;align-items:flex-start;}
.reflita-box .ri{font-size:1rem;flex-shrink:0;}
.reflita-box p{font-size:.84rem;line-height:1.65;color:rgba(255,255,255,.7);margin:0;font-style:italic;}

/* DESTINO MANIFESTO */
.dm-badge{display:inline-block;background:var(--crimson);color:white;font-size:.62rem;font-family:'Montserrat',sans-serif;letter-spacing:.1em;text-transform:uppercase;padding:.25rem .7rem;border-radius:3px;margin-bottom:.7rem;}
.lacuna-wrap{background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);border-radius:10px;padding:1.1rem 1.3rem;font-size:.92rem;line-height:2.2;margin-bottom:.8rem;}
.lacuna{display:inline-block;border-bottom:2px solid #91c7ff;min-width:80px;text-align:center;margin:0 3px;padding:0 5px;cursor:text;background:rgba(41,128,185,.12);border-radius:3px 3px 0 0;font-style:italic;color:#91c7ff;font-weight:600;transition:background .2s;outline:none;}
.lacuna:focus{background:rgba(41,128,185,.25);}
.lacuna.correta{background:rgba(46,204,113,.18);border-color:#2ecc71;color:#6effa0;}
.lacuna.errada{background:rgba(220,53,69,.15);border-color:#dc3545;color:#ff9090;}
.banco{background:rgba(255,255,255,.04);border-radius:8px;padding:.8rem 1rem;margin-top:.6rem;font-size:.82rem;color:#d1e3f8;}
.chip{display:inline-block;background:var(--navy);color:var(--gold-light);border:1px solid rgba(201,168,76,.3);padding:.15rem .55rem;border-radius:4px;margin:.15rem;font-size:.78rem;font-family:'Montserrat',sans-serif;}
.af-card{background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.09);border-radius:10px;padding:1rem 1.1rem;margin-bottom:.85rem;}
.af-pergunta{font-size:.86rem;line-height:1.58;margin-bottom:.7rem;color:#d1e3f8;}
.af-botoes{display:flex;gap:.55rem;}
.btn-af{flex:1;padding:.45rem;border:2px solid;border-radius:5px;font-family:'Montserrat',sans-serif;font-size:.8rem;font-weight:600;cursor:pointer;transition:all .2s;background:transparent;}
.btn-v{border-color:#2ecc71;color:#2ecc71;}
.btn-f{border-color:var(--crimson);color:#ff9090;}
.btn-v:hover{background:#2ecc71;color:white;}
.btn-f:hover{background:var(--crimson);color:white;}
.btn-af.sel-certo{background:#2ecc71;color:white;border-color:#2ecc71;}
.btn-af.sel-errado{background:#dc3545;color:white;border-color:#dc3545;opacity:.75;}
.btn-af.bloq{pointer-events:none;}
.af-feedback{margin-top:.55rem;font-size:.8rem;font-style:italic;display:none;padding:.35rem .65rem;border-radius:5px;}
.af-feedback.ok{background:rgba(46,204,113,.15);color:#6effa0;display:block;border:1px solid rgba(46,204,113,.3);}
.af-feedback.não{background:rgba(220,53,69,.12);color:#ff9090;display:block;border:1px solid rgba(220,53,69,.3);}
.quiz-card{background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.09);border-radius:10px;padding:1.1rem 1.2rem;margin-bottom:1rem;}
.quiz-pergunta{font-size:.88rem;line-height:1.55;margin-bottom:.85rem;font-weight:600;color:#91c7ff;}
.opcoes{display:flex;flex-direction:column;gap:.45rem;}
.opcao{display:flex;align-items:flex-start;gap:.55rem;padding:.55rem .85rem;border:1.5px solid rgba(255,255,255,.1);border-radius:6px;cursor:pointer;font-size:.84rem;line-height:1.45;transition:all .18s;background:rgba(255,255,255,.04);color:#d1e3f8;}
.opcao:hover{border-color:var(--gold);background:rgba(201,168,76,.08);}
.opcoes.respondida .opcao{pointer-events:none;}
.opcoes.respondida .opcao:not(.certa):not(.errada){opacity:.45;}
.opcao.certa{background:rgba(46,204,113,.15);border-color:#2ecc71;color:#6effa0;pointer-events:none;}
.opcao.errada{background:rgba(220,53,69,.12);border-color:#dc3545;color:#ff9090;pointer-events:none;}
.opcao.neutra{opacity:.5;pointer-events:none;}
.letra{font-weight:700;color:var(--gold);min-width:1rem;font-size:.82rem;flex-shrink:0;}
.reflexao-card{background:rgba(26,42,74,.7);border:1px solid rgba(41,128,185,.3);border-radius:10px;padding:1.3rem;margin-bottom:.9rem;}
.reflexao-pergunta{font-family:'Montserrat',sans-serif;font-size:.88rem;font-style:italic;margin-bottom:.8rem;color:var(--gold-light);line-height:1.5;}
.reflexao-textarea{width:100%;min-height:80px;padding:.75rem;background:rgba(255,255,255,.06);border:1px solid rgba(41,128,185,.3);border-radius:6px;color:#d1e3f8;font-family:'Open Sans',sans-serif;font-size:.86rem;line-height:1.55;resize:vertical;}
.reflexao-textarea:focus{outline:none;border-color:var(--gold);}
.btn-verificar{display:inline-block;background:var(--crimson);color:white;border:none;padding:.6rem 1.4rem;border-radius:5px;font-family:'Montserrat',sans-serif;font-size:.84rem;font-weight:600;cursor:pointer;margin-top:.7rem;transition:background .2s;}
.btn-verificar:hover{background:#951820;}
.btn-finalizar-dm{display:block;width:100%;background:var(--gold);color:var(--navy);border:none;padding:.85rem;border-radius:8px;font-family:'Montserrat',sans-serif;font-size:1rem;font-weight:700;cursor:pointer;margin-top:1.5rem;transition:background .2s;}
.btn-finalizar-dm:hover{background:#b07e20;}
#resultado-dm{display:none;background:rgba(26,42,74,.9);border:1px solid rgba(201,168,76,.3);border-radius:12px;padding:1.8rem 1.4rem;text-align:center;margin-top:1.5rem;}
#resultado-dm h2{font-family:'Montserrat',sans-serif;font-size:1.5rem;color:var(--gold);margin-bottom:.4rem;}
.dm-placar{font-size:2.8rem;font-family:'Montserrat',sans-serif;color:white;margin:.4rem 0;}
.dm-msg{font-size:.9rem;color:#a8b8d0;font-style:italic;margin-top:.4rem;line-height:1.5;}
.dm-estrelas{font-size:1.8rem;margin:.7rem 0;}

/* BANDEIRA */
.flag-box{border-radius:8px;overflow:hidden;box-shadow:0 4px 16px rgba(0,0,0,.35);margin:1rem 0;}
.flag-caption{padding:.6rem .9rem;font-size:.75rem;color:rgba(255,255,255,.5);font-style:italic;background:rgba(255,255,255,.04);border-top:1px solid rgba(255,255,255,.07);}

/* PERSONAGENS */
.characters-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(170px,1fr));gap:9px;margin:.9rem 0;}
.char-card{background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.08);border-radius:12px;padding:.85rem;text-align:center;transition:transform .2s;}
.char-card:hover{transform:translateY(-3px);box-shadow:0 6px 18px rgba(0,0,0,.25);}
.char-icon{font-size:1.8rem;margin-bottom:4px;display:block;}
.char-card h4{font-family:'Montserrat',sans-serif;font-size:.78rem;color:#91c7ff;margin-bottom:3px;}
.char-card p{font-size:.76rem;color:rgba(255,255,255,.5);line-height:1.5;}

/* CONTRADIÇÕES */
.contradiction-box{background:rgba(139,26,26,.1);border:2px solid rgba(139,26,26,.4);border-radius:12px;padding:1rem;margin:1.2rem 0;}
.contradiction-box h3{font-family:'Montserrat',sans-serif;color:#ff9090;font-size:.84rem;margin-bottom:8px;}
.contradiction-box ul{padding-left:1.2rem;line-height:1.85;font-size:.86rem;color:#d1e3f8;}

/* IMPACTO */
.impact-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:.9rem 0;}
@media(max-width:560px){.impact-grid{grid-template-columns:1fr;}}
.impact-card{background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.08);border-radius:12px;padding:.9rem;border-top:3px solid;}
.impact-card.modern{border-top-color:var(--accent);}
.impact-card.contemporary{border-top-color:var(--crimson);}
.impact-card h4{font-family:'Montserrat',sans-serif;font-size:.76rem;margin-bottom:7px;}
.impact-card ul{padding-left:1rem;font-size:.82rem;line-height:1.78;color:#d1e3f8;}

/* AVENTURAS */
.aventuras-card{background:rgba(26,42,74,.6);border:1px solid rgba(201,168,76,.25);border-radius:14px;overflow:hidden;margin:1.2rem 0;}
.aventuras-header{background:rgba(201,168,76,.15);padding:.8rem 1.1rem;border-bottom:1px solid rgba(201,168,76,.2);display:flex;align-items:center;gap:8px;}
.aventuras-header h4{font-family:'Montserrat',sans-serif;font-size:.82rem;color:var(--gold);}
.aventuras-header a{font-size:.65rem;color:rgba(201,168,76,.6);text-decoration:none;margin-left:auto;}
.aventuras-header a:hover{color:var(--gold);text-decoration:underline;}
.aventuras-body{padding:1rem 1.1rem;}
.aventuras-body p{font-size:.85rem;line-height:1.75;color:#d1e3f8;margin-bottom:.7rem;}

/* ATIVIDADE NOTA */
.activity-nota{background:linear-gradient(135deg,rgba(201,168,76,.08),rgba(201,168,76,.03));border:2px solid rgba(201,168,76,.4);border-radius:14px;padding:1.2rem;margin:1.3rem 0;box-shadow:0 4px 18px rgba(201,168,76,.12);position:relative;overflow:hidden;}
.activity-nota::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,var(--crimson),var(--gold),var(--navy));}
.nota-badge{display:inline-flex;align-items:center;gap:5px;background:var(--crimson);color:white;font-family:'Montserrat',sans-serif;font-size:.64rem;padding:3px 9px;border-radius:20px;margin-bottom:8px;letter-spacing:.5px;}
.activity-nota h3{font-family:'Montserrat',sans-serif;color:var(--gold-light);font-size:.86rem;margin-bottom:8px;}
.activity-nota p{font-size:.86rem;line-height:1.75;color:#d1e3f8;font-style:italic;}
.nota-value{font-family:'Montserrat',sans-serif;color:var(--gold);font-size:.78rem;margin-top:6px;font-style:normal;font-weight:700;}
.confirm-check-wrap{display:flex;align-items:center;gap:9px;margin-top:10px;padding-top:10px;border-top:1px solid rgba(201,168,76,.25);cursor:pointer;}
.confirm-check-wrap input[type="checkbox"]{width:16px;height:16px;accent-color:var(--gold);cursor:pointer;flex-shrink:0;}
.confirm-check-wrap label{font-family:'Montserrat',sans-serif;font-size:.8rem;color:var(--gold-light);cursor:pointer;}

/* VIDEO */
.video-context-box{background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.08);border-radius:12px;padding:.9rem 1.1rem;margin-bottom:.85rem;border-left:4px solid #c00;}
.video-context-box p{font-size:.84rem;line-height:1.7;color:rgba(255,255,255,.65);margin:0;}
.video-label{font-family:'Montserrat',sans-serif;font-size:.68rem;color:rgba(255,255,255,.3);text-align:center;margin-top:6px;font-style:italic;}
.btn-youtube-wrap{text-align:center;margin:1.2rem 0;}
.btn-youtube{display:inline-flex;align-items:center;gap:11px;background:#c00;color:white;padding:13px 26px;border-radius:50px;text-decoration:none;font-weight:700;font-family:'Montserrat',sans-serif;font-size:.88rem;box-shadow:0 6px 20px rgba(204,0,0,.4);transition:all .3s;border:none;cursor:pointer;letter-spacing:.5px;}
.btn-youtube:hover{background:#a00;transform:scale(1.04);box-shadow:0 10px 28px rgba(204,0,0,.5);}
.btn-youtube svg{width:21px;height:21px;fill:white;flex-shrink:0;}

/* FLAGS GRID */
.flags-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin:1rem 0;}
.flag-item{background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.09);border-radius:10px;overflow:hidden;}
.flag-item-caption{padding:.6rem .85rem;font-size:.72rem;color:rgba(255,255,255,.55);font-style:italic;line-height:1.4;}
.flag-item-caption strong{color:rgba(255,255,255,.8);font-style:normal;display:block;margin-bottom:2px;}

/* MAPA SECESSÃO */
#map-secessao{width:100%;border-radius:14px;overflow-x:auto;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.1);margin:1.1rem 0;}
#map-secessao svg{width:100%;height:auto;display:block;}
.sec-state{cursor:pointer;transition:all .25s;}
.sec-state:hover{opacity:.8;}
.sec-state.active{stroke:white;stroke-width:2;filter:drop-shadow(0 0 6px rgba(201,168,76,.8));}
.secmap-legend{display:flex;gap:1rem;padding:.8rem 1rem;flex-wrap:wrap;justify-content:center;}
.secmap-leg-item{font-size:.7rem;padding:.2rem .6rem;border-radius:4px;}
.secmap-leg-item.norte{background:#2c5f9e;color:white;}
.secmap-leg-item.sul{background:#8b6914;color:white;}
.secmap-leg-item.fronteira{background:#607080;color:white;}
#sec-info{padding:.95rem 1.1rem;border-top:1px solid rgba(255,255,255,.08);min-height:85px;}
#sec-info h4{font-family:'Montserrat',sans-serif;font-size:.88rem;margin-bottom:3px;}
#sec-info h4.norte{color:#4a90d9;}
#sec-info h4.sul{color:var(--gold);}
#sec-info h4.fronteira{color:#a0b0c0;}
#sec-info p{font-size:.82rem;color:#d1e3f8;line-height:1.65;}

/* ATIVIDADE OPÇÕES */
.atividade-opcoes{display:grid;gap:8px;margin:1.1rem 0;}
.ativ-opcao{background:rgba(255,255,255,.04);border:1.5px solid rgba(255,255,255,.1);border-radius:11px;padding:.9rem 1rem;display:flex;gap:10px;align-items:flex-start;cursor:pointer;transition:all .25s;}
.ativ-opcao:hover{border-color:var(--gold);background:rgba(201,168,76,.08);transform:translateX(3px);}
.ativ-opcao.chosen{border-color:var(--success);background:rgba(46,204,113,.08);}
.ativ-opcao-letra{font-family:'Montserrat',sans-serif;font-weight:700;font-size:.86rem;color:var(--gold);flex-shrink:0;width:20px;margin-top:1px;}
.ativ-opcao p{font-size:.84rem;line-height:1.65;color:#d1e3f8;margin:0;}
.ativ-chosen-label{text-align:center;font-family:'Montserrat',sans-serif;font-size:.75rem;color:var(--success);margin-top:.4rem;display:none;}
.ativ-chosen-label.visible{display:block;}
.caderno-confirm{background:rgba(201,168,76,.07);border:2px dashed rgba(201,168,76,.28);border-radius:11px;padding:.95rem 1.1rem;margin-top:.9rem;display:flex;gap:9px;align-items:center;cursor:pointer;}
.caderno-confirm input[type="checkbox"]{width:16px;height:16px;accent-color:var(--gold);cursor:pointer;flex-shrink:0;}
.caderno-confirm label{font-family:'Montserrat',sans-serif;font-size:.8rem;color:var(--gold-light);cursor:pointer;}

/* DIVIDER */
.divider{display:flex;align-items:center;gap:1rem;margin:1.5rem 0;}
.divider::before,.divider::after{content:'';flex:1;height:1px;background:linear-gradient(to right,transparent,rgba(201,168,76,.4),transparent);}
.divider-label{font-family:'Montserrat',sans-serif;font-size:.7rem;color:rgba(201,168,76,.6);white-space:nowrap;letter-spacing:1px;}

/* CONCLUSÃO */
#conclusion-display{display:none;text-align:center;padding:2rem;animation:fadeIn .8s ease;}
#conclusion-display.visible{display:block;}
.conclusion-star{font-size:3rem;display:block;margin-bottom:10px;}
