  document.getElementById('msg-login').textContent = '';
  fecharNav();
}

// ==================== NAVEGAÇÃO ====================
function irPara(n) {
  initAudio(); sndNav();
  var telas = document.querySelectorAll('.screen');
  for (var i = 0; i < telas.length; i++) telas[i].classList.remove('active');
  var t = document.getElementById('screen-'+n);
  if (t) t.classList.add('active');
  S.tela = n;
  if (S.unlocked.indexOf(n) < 0) S.unlocked.push(n);
  atualizarHUD(); atualizarMenu(); fecharNav();
  if (document.getElementById('conteudo')) document.getElementById('conteudo').scrollTop = 0;
  log('Missão '+n); salvarLocal();
}

function atualizarMenu() {
  for (var i = 1; i <= 6; i++) {
    var el = document.getElementById('menu-'+i);
    if (!el) continue;
    var ok = S.unlocked.indexOf(i) >= 0;
    if (ok) { el.classList.add('ativa'); el.setAttribute('onclick', 'irPara('+i+')'); }
    else { el.classList.remove('ativa'); el.setAttribute('onclick', ''); }
    if (S.tela === i) el.classList.add('atual'); else el.classList.remove('atual');
    var lockSpan = el.querySelector('.missão-lock');
    if (lockSpan) lockSpan.textContent = ok ? '✓' : '🔒';
  }
}

function desbloquearBtn(id, hintId, label) {
  var b = document.getElementById(id); if (!b) return;
  b.disabled = false; b.classList.remove('locked');
  b.textContent = '▶ '+label;
  var h = document.getElementById(hintId); if (h) h.style.display = 'none';
}

function checkUnlocks() {
  if (S.philoAbertos.length >= 6) desbloquearBtn('btn-next-1', 'hint-1', 'Continuar para a Independência');
